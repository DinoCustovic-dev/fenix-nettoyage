# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Resend (https://resend.com) — API key for the contact form.
RESEND_API_KEY=

# Where contact-form requests are delivered. Until the client's domain is
# verified in Resend, this MUST be the email the Resend account was created with.
CONTACT_TO_EMAIL=

# Sender. Leave empty to use "Fenix74 <onboarding@resend.dev>" (works without a
# domain). After verifying the domain in Resend: Fenix74 <contact@your-domain.fr>
CONTACT_FROM_EMAIL=

# Public site URL (canonical, sitemap, Open Graph). Defaults to the Vercel URL.
NEXT_PUBLIC_SITE_URL=

# Email shown on the site (contact section, footer, structured data).
NEXT_PUBLIC_CONTACT_EMAIL=
